
# --- Fly.io: /usr/local/bin/hermes shim ---
# The hermes CLI lives inside the venv at /opt/hermes/.venv/bin/hermes, which
# the upstream entrypoint activates for the gateway process. But `fly ssh
# console` spawns a fresh shell without that activation, so interactive
# commands like `hermes setup` and `hermes doctor` fail with "executable not
# found". This shim activates the venv and drops to the hermes user so those
# commands work from a plain SSH session.
# Note: COPY always runs as build-time root regardless of USER, so no USER
# switch needed — avoids permission issues in rootless BuildKit environments.
COPY --chmod=0755 hermes-shim /usr/local/bin/hermes

# --- Fly.io: bypass s6-overlay supervisor ---
# Upstream switched to s6-overlay supervision: ENTRYPOINT=["/init", ".../main-wrapper.sh"].
# s6-overlay's /init (s6-overlay-suexec) hard-requires PID 1, but Fly's
# machine init takes PID 1 inside the Firecracker VM, so /init runs as
# PID 2 and aborts with: "s6-overlay-suexec: fatal: can only run as pid 1".
#
# Workaround: replace the s6 /init entrypoint with a small shim that runs
# only the critical bootstrap cont-init script (01-hermes-setup: UID
# remap, volume chown, config seed, skills sync) and then exec's
# main-wrapper.sh — which activates the venv, drops to UID 10000 via
# s6-setuidgid, and exec's the CMD. The 015-/02- cont-init scripts and
# s6-rc services exist to supervise the dashboard + per-profile gateways;
# this single-service VM doesn't need them.
RUN printf '%s\n' \
        '#!/bin/sh' \
        '# Fly.io entrypoint: run the hermes bootstrap, then exec main-wrapper.' \
        'set -e' \
        '# /init normally prepends /command to PATH so scripts in the chain can' \
        '# find s6 utilities; we bypass /init, so do it here.' \
        'export PATH="/command:${PATH}"' \
        '# The privilege-drop (now via setpriv, patched below) does NOT reset HOME.' \
        '# Without /init setting up the environment, HOME stays /root and hermes' \
        '# (UID 10000) hits EACCES writing XDG state under /root/.local. Point HOME' \
        '# at the hermes user'"'"'s actual home (and the persistent volume).' \
        'export HOME=/opt/data' \
        '# main-wrapper.sh uses `#!/command/with-contenv sh`. with-contenv' \
        '# normally wipes the env (emptyenv -p, preserving only PATH) and then' \
        '# reloads vars from /run/s6/container_environment — a dir /init would' \
        '# populate at startup. Without /init the dir is missing (exit 111) and' \
        '# also empty (so Fly-injected secrets like TELEGRAM_BOT_TOKEN get' \
        '# wiped). The with-contenv shim has an explicit escape hatch: if' \
        '# S6_KEEP_ENV is non-zero it pass-through-execs without touching env.' \
        '# We use it + pre-create the dir as a safety net for any other script' \
        '# in the chain that still uses with-contenv defaults.' \
        'export S6_KEEP_ENV=1' \
        'mkdir -p /run/s6/container_environment' \
        'if [ -x /etc/cont-init.d/01-hermes-setup ]; then' \
        '    /etc/cont-init.d/01-hermes-setup' \
        'fi' \
        'exec /opt/hermes/docker/main-wrapper.sh "$@"' \
    > /usr/local/bin/fly-entrypoint.sh \
    && chmod 0755 /usr/local/bin/fly-entrypoint.sh

# --- Fly.io: patch main-wrapper.sh to avoid s6-setuidgid ---
# s6-setuidgid / s6-applyuidgid call setgroups() unconditionally, which is
# blocked by Fly.io's Firecracker seccomp profile (EPERM). Replace the drop()
# helper's privilege-drop with setpriv --reuid/--regid --keep-groups, which
# changes UID/GID without touching the supplementary group list and so avoids
# the syscall while satisfying newer setpriv argument validation.
RUN sed -i \
    's|set -- s6-setuidgid hermes "\$@"|set -- setpriv --reuid=10000 --regid=10000 --keep-groups "$@"|g' \
    /opt/hermes/docker/main-wrapper.sh

# Add /command to the image PATH so `fly ssh console` sessions (which
# spawn a fresh shell, not via fly-entrypoint.sh) can also find
# s6-setuidgid and the rest of the s6-overlay utilities.
ENV PATH="/command:${PATH}"

ENTRYPOINT ["/usr/local/bin/fly-entrypoint.sh"]

# --- Fly.io: run the messaging gateway by default ---
# `gateway run` runs every configured platform adapter in the foreground.
# (`gateway start` is for installing a systemd/launchd service on the host
# and is not supported inside a container.)
CMD ["gateway", "run"]
