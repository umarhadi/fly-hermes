#!/bin/sh
# Drop to the hermes user before running the venv'd hermes CLI.
#
# We use setpriv instead of s6-setuidgid/s6-applyuidgid: Fly.io's Firecracker
# sandbox blocks the setgroups() syscall (EPERM), which s6-applyuidgid calls
# unconditionally regardless of whether supplementary groups change. setpriv
# with only --reuid/--regid skips that syscall entirely.
#
# HOME is forced to /opt/data (the hermes user's actual home). Without this,
# a `fly ssh console` session (HOME=/root) causes hermes (UID 10000) to
# build paths under /root/.local and /root/.config and hit EACCES.
#
# Guard: if already running as hermes (UID 10000), exec directly — calling
# any setuid helper from a non-root process also fails with EPERM.
export HOME=/opt/data
if [ "$(id -u)" = "0" ]; then
    exec setpriv --reuid=10000 --regid=10000 /opt/hermes/.venv/bin/hermes "$@"
else
    exec /opt/hermes/.venv/bin/hermes "$@"
fi
